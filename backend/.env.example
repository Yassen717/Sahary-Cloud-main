#HOSTING_ALLOW_UNPAID_ACCOUNTS=false

# nginx vhost provisioning (platform subdomains + suspended pages)
#HOSTING_NGINX_STAGING_DIR="/etc/nginx/sites-staging"
#HOSTING_NGINX_LOG_DIR="/var/log/nginx/sahary"

