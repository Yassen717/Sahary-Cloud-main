# retention before auto-termination / past-due grace before suspension.
#HOSTING_TRASH_DIR="/var/www/.trash"
#HOSTING_RETENTION_DAYS=7
#HOSTING_SUSPENDED_RETENTION_DAYS=30
#HOSTING_PAST_DUE_GRACE_DAYS=7
# Background jobs (metering, SSL, reconcile, retention)
#HOSTING_JOBS_ENABLED=true
