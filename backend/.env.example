# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/sahary_cloud?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DEFAULT_TTL=3600
CACHE_CLEANUP_SCHEDULE="0 * * * *"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRE="30d"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_REFRESH_EXPIRE="7d"

# Session Configuration
SESSION_SECRET="your-session-secret-key"
SESSION_MAX_AGE=86400000

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@saharycloud.com"
FROM_NAME="Sahary Cloud"

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Solar Energy Monitoring API
SOLAR_API_URL="http://localhost:8080"
SOLAR_API_KEY="your-solar-monitoring-api-key"
SOLAR_COLLECTION_SCHEDULE="*/15 * * * *"

# Solar Alert Thresholds
LOW_PRODUCTION_THRESHOLD=20
CRITICAL_PRODUCTION_THRESHOLD=10
LOW_BATTERY_THRESHOLD=30
CRITICAL_BATTERY_THRESHOLD=15
HIGH_CONSUMPTION_THRESHOLD=90

# Docker Configuration
DOCKER_HOST="unix:///var/run/docker.sock"
DOCKER_REGISTRY="registry.saharycloud.com"
DOCKER_TLS_VERIFY=false
DOCKER_CERT_PATH=""
DOCKER_VM_NETWORK="sahary-vm-network"
DOCKER_VM_SUBNET="172.25.0.0/16"

# Shared Hosting / Nginx VHost
HOSTING_NGINX_ENABLED=false
HOSTING_NGINX_SITES_AVAILABLE="/etc/nginx/sites-available"
HOSTING_NGINX_SITES_ENABLED="/etc/nginx/sites-enabled"
HOSTING_NGINX_TEST_COMMAND="nginx -t"
HOSTING_NGINX_RELOAD_COMMAND="nginx -s reload"
HOSTING_WWW_BASE="/var/www"
HOSTING_BASE_DOMAIN="sahary.cloud"

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Stricter per-IP limit for credential endpoints (login, register, forgot/reset password)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"

# Error Tracking
ERROR_THRESHOLD=10
ERROR_TIME_WINDOW=60000

# Performance Monitoring
SLOW_REQUEST_THRESHOLD=1000

# DDoS Protection
DDOS_REQUEST_THRESHOLD=100
DDOS_TIME_WINDOW=60000
DDOS_BLOCK_DURATION=3600000
MAX_CONNECTIONS_PER_IP=10

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN="http://localhost:3001"

# Application URLs
FRONTEND_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3000"
API_BASE_URL="/api/v1"

# Feature Flags
ENABLE_SOLAR_MONITORING=true
ENABLE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
# Docker/VPS virtual machines (out of scope for the hosting MVP)
ENABLE_VPS=false

# ── Hosting MVP ─────────────────────────────────────────────────────────────
