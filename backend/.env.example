#HOSTING_LETSENCRYPT_LIVE_DIR="/etc/letsencrypt/live"
#HOSTING_WILDCARD_CERT_PATH=""
#HOSTING_WILDCARD_KEY_PATH=""

# Web file manager limits
#HOSTING_UPLOAD_MAX_MB=50
#HOSTING_TEXT_EDIT_MAX_KB=1024

# Job schedules
#HOSTING_METER_CRON="0 * * * *"
#HOSTING_SSL_CRON="*/10 * * * *"
#HOSTING_RECONCILE_CRON="15 */6 * * *"
#HOSTING_RETENTION_CRON="30 3 * * *"