{
  "name": "sahary-cloud-backend",
  "version": "1.0.0",
  "description": "Sahary Cloud - Solar-powered VPS and hosting platform backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run start:ts",
    "dev": "npm run dev:ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build:ts": "tsc -p tsconfig.json",
    "dev:ts": "tsx watch src/index.ts",
    "start:ts": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "prisma:reset": "prisma migrate reset",
    "db:setup": "./scripts/setup-db.sh",
    "db:start": "docker-compose -f docker-compose.dev.yml up -d",
    "db:stop": "docker-compose -f docker-compose.dev.yml down",
    "db:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "openapi:export": "tsx scripts/export-openapi.js",
    "lint": "eslint src/ --ext .js,.ts --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src/ --ext .js,.ts --no-error-on-unmatched-pattern --fix"
  },
  "keywords": [
    "vps",
    "hosting",
    "solar-energy",
    "cloud",
    "nodejs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Sahary Cloud Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "express-slow-down": "^3.1.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "prisma": "^5.7.1",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.11",
    "socket.io": "^4.8.4",
    "stripe": "^14.9.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^29.5.8",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "engine.io": "^6.6.10",
    "express-slow-down": {
      "express-rate-limit": "^8.5.1"
    },
    "js-yaml@3": "^3.15.2",
    "js-yaml@4": "^4.3.2",
    "moment": "^2.31.0",
    "protobufjs": "^7.6.5",
    "proxy-addr": "^2.0.8",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
